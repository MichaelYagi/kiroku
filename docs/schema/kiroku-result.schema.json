        "chosen": {
          "$ref": "#/$defs/TagReference"
        },
        "reason": {
          "type": "string"
        },
        "conflict": {
          "type": "boolean"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldCandidate"
          }
        }
      }
    },
    "FullMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "$ref": "#/$defs/FileProbe"
        },
        "container": {
          "$ref": "#/$defs/ContainerInfo"
        },
        "directories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DirectoryInfo"
          }
        },
        "streams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StreamInfo"
          }
        },
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChapterInfo"
          }
        },
        "embeddedImages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EmbeddedImageInfo"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RawObservation"
          }
        },
        "fieldProvenance": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/FieldProvenance"
          }
        }
      }
    },
    "MetadataDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
