        },
        "rank": {
          "type": "integer"
        },
        "accepted": {
          "type": "boolean"
        },
        "rejectionReason": {
          "type": "string"
        }
      }
    },
    "FieldProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string"
