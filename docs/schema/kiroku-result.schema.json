        },
        "duration": {
          "type": "string",
          "description": "ISO-8601 duration, e.g. PT12.5S"
        }
      }
    },
    "GalleryFile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "extension": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer"
        },
        "detectedFormat": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "createdAtFileSystem": {
          "type": "string",
          "format": "date-time"
        },
        "modifiedAtFileSystem": {
          "type": "string",
          "format": "date-time"
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "name",
        "sizeBytes",
        "detectedFormat"
      ]
    },
