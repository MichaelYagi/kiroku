          "type": "integer"
        },
        "occurrence": {
          "type": "integer"
        },
        "sourcePath": {
          "type": "string"
        },
        "fidelity": {
          "enum": [
            "BYTE_EXACT",
            "BACKEND_RECONSTRUCTED",
            "BACKEND_DECODED",
            "DESCRIPTION_ONLY"
          ]
        },
        "original": {
          "$ref": "#/$defs/OriginalValue"
        }
      },
      "required": [
        "index",
        "backend",
        "groupPath",
        "tagName",
        "valueType",
        "value",
        "occurrence",
        "fidelity",
        "known"
      ]
    },
    "TagReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observationIndex": {
          "type": "integer"
        },
        "backend": {
          "type": "string"
        },
        "qualifiedName": {
          "type": "string"
        },
        "tagId": {
          "type": "integer"
        },
        "occurrence": {
          "type": "integer"
        },
        "streamIndex": {
          "type": "integer"
        }
      }
    },
    "FieldCandidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
