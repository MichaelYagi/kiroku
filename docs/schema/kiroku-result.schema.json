        "camera": {
          "$ref": "#/$defs/CameraMetadata"
        },
        "exposure": {
          "$ref": "#/$defs/ExposureMetadata"
        },
        "location": {
          "$ref": "#/$defs/GeoMetadata"
        },
        "description": {
          "$ref": "#/$defs/DescriptionMetadata"
        },
        "color": {
          "$ref": "#/$defs/ColorMetadata"
        },
        "video": {
          "$ref": "#/$defs/VideoMetadata"
        },
        "audio": {
          "$ref": "#/$defs/AudioMetadata"
        },
        "animation": {
          "$ref": "#/$defs/AnimationMetadata"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extra": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/NormalizedValue"
          }
        }
      },
      "required": [
        "mediaKind",
        "file",
        "keywords",
        "extra"
      ]
    },
