{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiroku.dev/schema/kiroku-result-1.0.0.json",
  "title": "Kiroku MetadataResult",
  "description": "Output of dev.kiroku.json.KirokuJson.toJson, schema version 1.0.0. With JsonOptions.includeNulls=false (default) absent fields are omitted; with includeNulls=true they are written as null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "gallery",
    "diagnostics",
    "backendRuns"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNSUPPORTED",
        "FAILED"
      ]
    },
    "gallery": {
      "$ref": "#/$defs/GalleryMetadata"
    },
    "full": {
      "$ref": "#/$defs/FullMetadata"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MetadataDiagnostic"
      }
    },
    "backendRuns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BackendRun"
      }
    }
  },
  "$defs": {
    "Rational": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "integer"
        },
        "denominator": {
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "NormalizedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "TEXT",
            "INTEGER",
            "DECIMAL",
            "RATIONAL",
            "BOOLEAN",
            "BINARY",
            "LIST",
            "OBJECT",
            "NULL"
          ]
        },
        "value": {
          "description": "Shape depends on type: string (TEXT), integer (INTEGER), number or 'NaN'/'Infinity' string (DECIMAL), Rational (RATIONAL), boolean (BOOLEAN), array of NormalizedValue (LIST), map of NormalizedValue (OBJECT). Absent for BINARY and NULL."
        },
        "length": {
          "type": "integer",
          "description": "Byte length, BINARY only. Bytes are in RawObservation.original."
        }
      }
    },
    "CaptureTimestamp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instant": {
          "type": "string",
          "format": "date-time"
        },
        "localDateTime": {
          "type": "string",
          "description": "ISO local date-time without offset"
        },
        "offset": {
          "type": "string"
        },
        "timezoneKnown": {
          "type": "boolean"
        },
        "precision": {
          "enum": [
            "YEAR",
            "MONTH",
            "DAY",
            "MINUTE",
            "SECOND",
            "MILLISECOND",
            "MICROSECOND",
            "NANOSECOND"
          ]
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "timezoneKnown",
        "precision",
        "source"
      ]
    },
    "Dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storedWidth": {
          "type": "integer"
        },
        "storedHeight": {
          "type": "integer"
        },
        "displayWidth": {
          "type": "integer"
        },
        "displayHeight": {
          "type": "integer"
        },
        "megapixels": {
          "type": "number"
        },
        "pixelAspectRatio": {
          "$ref": "#/$defs/Rational"
        },
        "aspectRatio": {
          "$ref": "#/$defs/Rational"
        }
      }
    },
    "Orientation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exifCode": {
          "type": "integer"
        },
        "rotationDegrees": {
          "enum": [
            0,
            90,
            180,
            270
          ]
        },
        "mirrored": {
          "type": "boolean"
        },
        "transformMatrix": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "source": {
          "type": "string"
        }
      }
    },
    "CameraMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "make": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "deviceName": {
          "type": "string"
        },
        "lensMake": {
          "type": "string"
        },
        "lensModel": {
          "type": "string"
        },
        "lensSerialNumber": {
          "type": "string"
        },
        "cameraSerialNumber": {
          "type": "string"
        },
        "firmware": {
          "type": "string"
        },
        "software": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "cameraType": {
          "type": "string"
        },
        "deviceIdentifier": {
          "type": "string"
        }
      }
    },
    "FlashInfo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "integer"
        },
        "fired": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "ON",
            "OFF",
            "AUTO"
          ]
        },
        "redEyeReduction": {
          "type": "boolean"
        },
        "present": {
          "type": "boolean"
        }
      }
    },
    "ExposureMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iso": {
          "type": "integer"
        },
        "exposureTimeSeconds": {
          "type": "number"
        },
        "exposureTime": {
          "$ref": "#/$defs/Rational"
        },
        "apertureFNumber": {
          "type": "number"
        },
        "focalLengthMm": {
          "type": "number"
        },
        "focalLength35mmEquivalentMm": {
          "type": "number"
        },
        "exposureBiasEv": {
          "type": "number"
        },
        "meteringMode": {
          "type": "string"
        },
        "exposureProgram": {
          "type": "string"
        },
        "flash": {
          "$ref": "#/$defs/FlashInfo"
        },
        "whiteBalance": {
          "type": "string"
        },
        "focusMode": {
          "type": "string"
        },
        "digitalZoomRatio": {
          "type": "number"
        },
        "subjectDistanceMeters": {
          "type": "number"
        },
        "shutterSpeedApex": {
          "type": "number"
        },
        "brightnessValue": {
          "type": "number"
        },
        "sceneType": {
          "type": "string"
        },
        "stabilization": {
          "type": "string"
        },
        "hdrMode": {
          "type": "string"
        },
        "shootingMode": {
          "type": "string"
        }
      }
    },
    "GeoMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "altitudeMeters": {
          "type": "number"
        },
        "altitudeReference": {
          "enum": [
            "ABOVE_SEA_LEVEL",
            "BELOW_SEA_LEVEL",
            "ABOVE_ELLIPSOID",
            "UNKNOWN"
          ]
        },
        "accuracyMeters": {
          "type": "number"
        },
        "headingDegrees": {
          "type": "number"
        },
        "speedMetersPerSecond": {
          "type": "number"
        },
        "directionDegrees": {
          "type": "number"
        },
        "locationTimestamp": {
          "type": "string",
          "format": "date-time"
        },
        "gpsDatum": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "DescriptionMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "artist": {
          "type": "string"
        },
        "copyright": {
          "type": "string"
        },
        "creator": {
          "type": "string"
        },
        "credit": {
          "type": "string"
        },
        "rights": {
          "type": "string"
        },
        "originalFilename": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "album": {
          "type": "string"
        },
        "rating": {
          "type": "integer",
          "minimum": -1,
          "maximum": 5
        }
      }
    },
    "ColorMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colorSpace": {
          "type": "string"
        },
        "iccProfileName": {
          "type": "string"
        },
        "iccProfileDescription": {
          "type": "string"
        },
        "transferCharacteristics": {
          "type": "string"
        },
        "colorPrimaries": {
          "type": "string"
        },
        "matrixCoefficients": {
          "type": "string"
        },
        "pixelFormat": {
          "type": "string"
        },
        "chromaSubsampling": {
          "type": "string"
        },
        "bitDepth": {
          "type": "integer"
        },
        "bitsPerPixel": {
          "type": "integer"
        },
        "hdr": {
          "type": "boolean"
        }
      }
    },
    "VideoTrackSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "streamIndex": {
          "type": "integer"
        },
        "codec": {
          "type": "string"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "frameRate": {
          "$ref": "#/$defs/Rational"
        },
        "bitRateBitsPerSecond": {
          "type": "integer"
        },
        "duration": {
          "type": "string",
          "description": "ISO-8601 duration, e.g. PT12.5S"
        },
        "language": {
          "type": "string"
        },
        "rotationDegrees": {
          "type": "integer"
        },
        "isDefault": {
          "type": "boolean"
        }
      }
    },
    "AudioTrackSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "streamIndex": {
          "type": "integer"
        },
        "codec": {
          "type": "string"
        },
        "sampleRateHz": {
          "type": "integer"
        },
        "channels": {
          "type": "integer"
        },
        "channelLayout": {
          "type": "string"
        },
        "bitRateBitsPerSecond": {
          "type": "integer"
        },
        "bitsPerSample": {
          "type": "integer"
        },
        "duration": {
          "type": "string",
          "description": "ISO-8601 duration, e.g. PT12.5S"
        },
        "language": {
          "type": "string"
        },
        "isDefault": {
          "type": "boolean"
        }
      }
    },
    "VideoMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration": {
          "type": "string",
          "description": "ISO-8601 duration, e.g. PT12.5S"
        },
        "frameRate": {
          "$ref": "#/$defs/Rational"
        },
        "averageFrameRate": {
          "$ref": "#/$defs/Rational"
        },
        "codec": {
          "type": "string"
        },
        "codecProfile": {
          "type": "string"
        },
        "codecLevel": {
          "type": "string"
        },
        "bitRateBitsPerSecond": {
          "type": "integer"
        },
        "container": {
          "type": "string"
        },
        "streamCount": {
          "type": "integer"
        },
        "primaryStreamIndex": {
          "type": "integer"
        },
        "rotationDegrees": {
          "type": "integer"
        },
        "variableFrameRate": {
          "type": "boolean"
        },
        "timeBase": {
          "$ref": "#/$defs/Rational"
        },
        "creationTime": {
          "type": "string",
          "format": "date-time"
        },
        "encoder": {
          "type": "string"
        },
        "audioStreamCount": {
          "type": "integer"
        },
        "videoStreamCount": {
          "type": "integer"
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VideoTrackSummary"
          }
        }
      }
    },
    "AudioMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration": {
          "type": "string",
          "description": "ISO-8601 duration, e.g. PT12.5S"
        },
        "codec": {
          "type": "string"
        },
        "sampleRateHz": {
          "type": "integer"
        },
        "channels": {
          "type": "integer"
        },
        "channelLayout": {
          "type": "string"
        },
        "bitRateBitsPerSecond": {
          "type": "integer"
        },
        "bitsPerSample": {
          "type": "integer"
        },
        "language": {
          "type": "string"
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AudioTrackSummary"
          }
        }
      }
    },
    "AnimationMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frameCount": {
          "type": "integer"
        },
        "loopCount": {
