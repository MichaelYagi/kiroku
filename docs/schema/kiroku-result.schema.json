            "INFO",
            "WARNING",
            "ERROR"
          ]
        },
        "message": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "causeClass": {
          "type": "string"
        }
      },
      "required": [
